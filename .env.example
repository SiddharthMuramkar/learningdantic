# ── learningdantic environment ─────────────────────────────────────────────
# Copy this file to `.env` and fill in your key:
#     cp .env.example .env
# `.env` is gitignored, so your keys never get committed.
# Edited .env while Jupyter is open? Use Kernel → Restart, then run the setup cell again.

# Which model the notebooks use: "<provider>:<model>" (a bare model name is an error in v2).
# Leave it commented out to use the course default (openai:gpt-6-luna, set as DEFAULT_MODEL in
# src/learningdantic/__init__.py).
# Want stronger answers? openai:gpt-6.1-sol costs about 15x more per call (still cents per notebook).
# MODEL=openai:gpt-6-luna

# Your OpenAI API key (https://platform.openai.com/)
OPENAI_API_KEY=

# Other providers: uncomment, and set MODEL to match (support is already installed).
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ChatGPT/Codex subscription instead of an API key? Install the Codex CLI, run `codex login` once,
# then set MODEL=openai-codex:<model> and leave OPENAI_API_KEY empty.
#     https://pydantic.dev/docs/ai/models/openai-codex/

# Optional: Logfire. Paste a project write token here (Logfire UI → your project → Settings → Write tokens),
# or run `uv run logfire auth` and then `uv run logfire projects new` from the repo root.
# Free tier: 10M spans, logs or metrics a month, no card: https://logfire.pydantic.dev
# LOGFIRE_TOKEN=
