# ── learningdantic environment ─────────────────────────────────────────────
# Copy this file to `.env` and fill in your key:
#     cp .env.example .env
# `.env` is gitignored — never commit real keys.

# Pydantic AI v2 model string: "<provider>:<model>" (bare names are an error in v2).
# Docs currently quote gpt-6.1-sol; gpt-5.6-sol / gpt-5.5 also work with an OpenAI key.
MODEL=openai:gpt-6.1-sol

# Your provider API key (default provider: OpenAI — https://platform.openai.com/)
OPENAI_API_KEY=

# Using your ChatGPT/Codex subscription instead of an API key? See:
#     https://pydantic.dev/docs/ai/models/openai-codex/
# (then set MODEL=openai-codex:<model> and leave OPENAI_API_KEY blank)

# Other providers (uncomment, set MODEL accordingly — the full pydantic-ai
# bundle already ships these extras):
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Optional — Logfire. For local dev, prefer `uv run logfire auth` (browser login,
# writes .logfire/ which is gitignored). A token here also covers CI/shared machines.
# Free personal tier: 10M spans/month, no card — https://logfire.pydantic.dev
# LOGFIRE_TOKEN=
